// Menu Interface
void menu() {
    int choice;
    int accNum;

    do {
        cout << "\n=========================================";
        cout << "\n        BANK MANAGEMENT SYSTEM           ";
        cout << "\n=========================================";
        cout << "\n1. Open New Account";
