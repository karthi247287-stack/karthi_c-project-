        cout << "\n6. Close an Account";
        cout << "\n7. Exit";
        cout << "\n=========================================";
        cout << "\nEnter option (1-7): ";
        cin >> choice;

        if (cin.fail()) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "\nInvalid key! Please select a valid choice.\n";
            continue;
        }

        switch (choice) {
            case 1:
                writeNewAccount();
                break;
            case 2:
                cout << "\nEnter Account Number: ";
                cin >> accNum;
                checkBalance(accNum);
                break;
            case 3:
                cout << "\nEnter Account Number: ";
                cin >> accNum;
                performTransaction(accNum, 1);
                break;
            case 4:
                cout << "\nEnter Account Number: ";
                cin >> accNum;
                performTransaction(accNum, 2);
                break;
            case 5:
                displayAllAccounts();
                break;
            case 6:
                cout << "\nEnter Account Number to close: ";
                cin >> accNum;
                closeAccount(accNum);
                break;
            case 7:
                cout << "\nThank you for using our Banking Application. Goodbye!\n";
                break;
            default:
                cout << "\nInvalid choice. Try again.";
        }
    } while (choice != 7);
}

